{%- if profile.assistant and profile.assistant.enabled %}
<!-- Curated "ask" widget. Client-side only — no backend, no LLM, no API key.
     Answers come from profile.assistant.qa; honest fallback for anything else. -->
<button class="chat-fab" id="chat-fab" type="button" aria-label="Ask a question" aria-expanded="false" aria-controls="chat-panel">
  <img src="{{ profile.assistant.avatar }}" alt="" />
</button>

<div class="chat-panel" id="chat-panel" role="dialog" aria-label="Ask a question" hidden>
  <div class="chat-head">
    <img class="chat-head-avatar" src="{{ profile.assistant.avatar }}" alt="" />
    <div class="chat-head-text">
      <strong>{{ profile.assistant.name }}</strong>
      <span>{{ profile.assistant.subtitle }}</span>
    </div>
    <button class="chat-close" id="chat-close" type="button" aria-label="Close">&times;</button>
  </div>
  <div class="chat-log" id="chat-log" aria-live="polite"></div>
  <div class="chat-chips" id="chat-chips"></div>
  <form class="chat-input" id="chat-form">
    <input id="chat-text" type="text" autocomplete="off" placeholder="Ask a question…" aria-label="Ask a question" />
    <button type="submit" aria-label="Send">Ask</button>
  </form>
</div>

<script>
  (function () {
    var QA = {{ profile.assistant.qa | dump | safe }};
    var GREETING = {{ profile.assistant.greeting | dump | safe }};
    var FALLBACK = {{ profile.assistant.fallback | dump | safe }};

    var fab = document.getElementById("chat-fab");
    var panel = document.getElementById("chat-panel");
    var log = document.getElementById("chat-log");
    var chips = document.getElementById("chat-chips");
    var form = document.getElementById("chat-form");
    var input = document.getElementById("chat-text");
    var closeBtn = document.getElementById("chat-close");
    if (!fab || !panel) return;
    var started = false;

    function bubble(html, who) {
      var d = document.createElement("div");
      d.className = "chat-msg " + (who === "user" ? "chat-msg--user" : "chat-msg--bot");
      if (who === "user") { d.textContent = html; } else { d.innerHTML = html; }
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
    }
    function answerItem(item) {
      bubble(item.q, "user");
      setTimeout(function () { bubble(item.a, "bot"); }, 180);
    }
    function renderChips() {
      chips.innerHTML = "";
      QA.forEach(function (item) {
        var b = document.createElement("button");
        b.type = "button";
        b.className = "chat-chip";
        b.textContent = item.q;
        b.addEventListener("click", function () { answerItem(item); });
        chips.appendChild(b);
      });
    }
    function answerText(text) {
      var t = text.toLowerCase();
      var best = null, bestScore = 0;
      QA.forEach(function (item) {
        var score = 0;
        (item.keywords || []).forEach(function (k) { if (t.indexOf(k) !== -1) score++; });
        if (score > bestScore) { bestScore = score; best = item; }
      });
      bubble(text, "user");
      setTimeout(function () { bubble(bestScore > 0 ? best.a : FALLBACK, "bot"); }, 180);
    }
    function openPanel() {
      panel.removeAttribute("hidden");
      fab.setAttribute("aria-expanded", "true");
      fab.classList.add("is-open");
      if (!started) { started = true; bubble(GREETING, "bot"); renderChips(); }
      setTimeout(function () { input.focus(); }, 50);
    }
    function closePanel() {
      panel.setAttribute("hidden", "");
      fab.setAttribute("aria-expanded", "false");
      fab.classList.remove("is-open");
    }
    fab.addEventListener("click", function () { panel.hasAttribute("hidden") ? openPanel() : closePanel(); });
    closeBtn.addEventListener("click", closePanel);
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !panel.hasAttribute("hidden")) closePanel(); });
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var v = input.value.trim();
      if (!v) return;
      input.value = "";
      answerText(v);
    });
  })();
</script>
{%- endif %}
